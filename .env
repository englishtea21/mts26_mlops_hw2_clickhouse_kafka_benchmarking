# --- Образы ---
ZOOKEEPER_IMAGE=confluentinc/cp-zookeeper:7.3.0
KAFKA_IMAGE=confluentinc/cp-kafka:7.3.0
KAFKA_UI_IMAGE=provectuslabs/kafka-ui:latest
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:24.3

# --- Порты ---
# Внутри сети compose:
KAFKA_BROKERS=kafka:9092
ZOOKEEPER_CONNECT=zookeeper:2181
# На хосте:
KAFKA_HOST_BROKERS=localhost:9095
KAFKA_HOST_PORT=9095
ZOOKEEPER_HOST_PORT=2181
# --- Порты UI, проброшенные на хост ---
KAFKA_UI_PORT=8080
INTERFACE_PORT=8501

# --- ClickHouse ---
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse

# --- Топики ---
KAFKA_TRANSACTIONS_TOPIC=transactions

# --- Group ID ---
KAFKA_TRANSACTIONS_GROUP_ID=transactions